{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:lint": "oxlint .",
    "check:eslint": "eslint",
    "check:tsc": "tsc",
    "check:fmt": "oxfmt --check .",
    "check:knip": "knip",
    "build": "npm run build --workspaces",
    "prepublish": "npm run build",
    "test": "run-p check:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "knip": "^6.0.0",
    "npm-run-all2": "^9.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.2",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
